{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factmodel:schema:consumer:0.1.0",
  "title": "Consumer",
  "description": "The agent, SQL generator or knowledge base that proves a layer. Details come in M3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "meaning",
    "layers"
  ],
  "properties": {
    "kind": {
      "const": "consumer"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "meaning": {
      "$ref": "#/$defs/text"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "corpus": {
      "description": "Where the equivalence corpus is. A real corpus stays outside the repository.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location"
      ],
      "properties": {
        "location": {
          "$ref": "#/$defs/text"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "synthetic": {
          "type": "boolean"
        }
      }
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "extensions": {
      "description": "A free map for adopters; never read by the core.",
      "type": "object"
    },
    "pin": {
      "description": "The exact version read; the format depends on the source kind.",
      "type": "string",
      "pattern": "^\\S.*@\\S+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
