{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factmodel:schema:finding:0.1.0",
  "title": "Finding",
  "description": "A register entry for a problem to fix.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "title",
    "status",
    "opened_on",
    "description"
  ],
  "properties": {
    "kind": {
      "const": "finding"
    },
    "id": {
      "$ref": "#/$defs/finding_id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "status": {
      "enum": [
        "open",
        "resolved",
        "wont_fix"
      ]
    },
    "opened_on": {
      "$ref": "#/$defs/date"
    },
    "closed_on": {
      "$ref": "#/$defs/date"
    },
    "about": {
      "$ref": "#/$defs/model_refs"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "resolution": {
      "$ref": "#/$defs/text"
    },
    "decision": {
      "$ref": "#/$defs/decision_id"
    },
    "evidence": {
      "$ref": "#/$defs/evidence_refs"
    },
    "records": {
      "$ref": "#/$defs/evidence_records"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "required": [
          "resolution",
          "evidence",
          "closed_on"
        ]
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "wont_fix"
          }
        }
      },
      "then": {
        "required": [
          "decision",
          "closed_on"
        ]
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^D-[0-9]{4}$"
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "pin",
        "status",
        "read_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "source": {
          "$ref": "#/$defs/slug"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "measurement": {
          "$ref": "#/$defs/measurement"
        },
        "status": {
          "enum": [
            "confirmed",
            "inferred",
            "unresolved",
            "retracted"
          ]
        },
        "read_on": {
          "$ref": "#/$defs/date"
        },
        "probe": {
          "$ref": "#/$defs/slug"
        },
        "environment": {
          "$ref": "#/$defs/slug"
        },
        "data_quality": {
          "enum": [
            "representative",
            "synthetic",
            "unknown"
          ]
        },
        "named_error": {
          "$ref": "#/$defs/text"
        },
        "superseded_by": {
          "$ref": "#/$defs/slug"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "oneOf": [
        {
          "required": [
            "quote"
          ]
        },
        {
          "required": [
            "measurement"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "retracted"
              }
            }
          },
          "then": {
            "required": [
              "named_error",
              "superseded_by"
            ]
          }
        },
        {
          "if": {
            "required": [
              "probe"
            ]
          },
          "then": {
            "required": [
              "environment",
              "data_quality"
            ]
          }
        }
      ]
    },
    "evidence_records": {
      "description": "Inline evidence records.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_record"
      },
      "minItems": 1
    },
    "evidence_refs": {
      "description": "Evidence IDs; at least one.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "extensions": {
      "description": "A free map for adopters; never read by the core.",
      "type": "object"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^F-[0-9]{4}$"
    },
    "measurement": {
      "description": "Counts and rates only, never values or identifiers.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "model_ref": {
      "description": "An entity ID or a relationship reference.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(\\.[a-z0-9][a-z0-9_-]{0,63})?$"
    },
    "model_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model_ref"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pin": {
      "description": "The exact version read; the format depends on the source kind.",
      "type": "string",
      "pattern": "^\\S.*@\\S+$"
    },
    "quote": {
      "description": "A verbatim quote, at most 40 words.",
      "type": "string",
      "pattern": "^\\s*\\S+(\\s+\\S+){0,39}\\s*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
