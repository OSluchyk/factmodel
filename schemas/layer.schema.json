{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factmodel:schema:layer:2.0.0",
  "title": "Semantic layer",
  "description": "A named set of concepts and measures for one use case, built only on physical facts by ID (D-019). semantic/<layer-id>/layer.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "purpose",
    "consumer",
    "status",
    "entities"
  ],
  "properties": {
    "kind": {
      "const": "layer"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "purpose": {
      "$ref": "#/$defs/text"
    },
    "consumer": {
      "$ref": "#/$defs/slug"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "deprecated"
      ]
    },
    "entities": {
      "description": "The physical entities the layer reads.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity",
          "current_row_rule"
        ],
        "properties": {
          "entity": {
            "$ref": "#/$defs/slug"
          },
          "current_row_rule": {
            "description": "Copied from the entity by reference; the gate checks it is equal.",
            "oneOf": [
              {
                "$ref": "#/$defs/text"
              },
              {
                "type": "null"
              }
            ]
          },
          "default_filters": {
            "description": "Ids of this layer's concepts applied by default when the entity is read.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/slug"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "joins": {
      "description": "Physical relationship references only, never free SQL.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship_ref"
      },
      "uniqueItems": true
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measure"
      }
    },
    "hazards": {
      "$ref": "#/$defs/hazard_refs"
    },
    "evidence": {
      "$ref": "#/$defs/evidence_refs"
    },
    "records": {
      "$ref": "#/$defs/evidence_records"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "concept": {
      "description": "A named filter - a value vocabulary on a field, a predicate, or a distinct rule.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "meaning"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "meaning": {
          "$ref": "#/$defs/text"
        },
        "field": {
          "$ref": "#/$defs/field_ref"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/text"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "predicate": {
          "description": "A boolean expression in the D-017 form over the layer's entities.",
          "$ref": "#/$defs/text"
        },
        "distinct": {
          "description": "Fields on which an entity's rows are made distinct before the layer joins to it.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/field_ref"
          }
        },
        "required": {
          "description": "Every query must apply this concept.",
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence_refs"
        }
      },
      "oneOf": [
        {
          "required": [
            "field"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "predicate"
                ]
              },
              {
                "required": [
                  "distinct"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "predicate"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "field"
                ]
              },
              {
                "required": [
                  "values"
                ]
              },
              {
                "required": [
                  "distinct"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "distinct"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "field"
                ]
              },
              {
                "required": [
                  "values"
                ]
              },
              {
                "required": [
                  "predicate"
                ]
              }
            ]
          }
        }
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "pin",
        "status",
        "read_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "source": {
          "$ref": "#/$defs/slug"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "measurement": {
          "$ref": "#/$defs/measurement"
        },
        "status": {
          "enum": [
            "confirmed",
            "inferred",
            "unresolved",
            "retracted"
          ]
        },
        "read_on": {
          "$ref": "#/$defs/date"
        },
        "probe": {
          "$ref": "#/$defs/slug"
        },
        "environment": {
          "$ref": "#/$defs/slug"
        },
        "data_quality": {
          "enum": [
            "representative",
            "synthetic",
            "unknown"
          ]
        },
        "named_error": {
          "$ref": "#/$defs/text"
        },
        "superseded_by": {
          "$ref": "#/$defs/slug"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "oneOf": [
        {
          "required": [
            "quote"
          ]
        },
        {
          "required": [
            "measurement"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "retracted"
              }
            }
          },
          "then": {
            "required": [
              "named_error",
              "superseded_by"
            ]
          }
        },
        {
          "if": {
            "required": [
              "probe"
            ]
          },
          "then": {
            "required": [
              "environment",
              "data_quality"
            ]
          }
        }
      ]
    },
    "evidence_records": {
      "description": "Inline evidence records.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_record"
      },
      "minItems": 1
    },
    "evidence_refs": {
      "description": "Evidence IDs; at least one.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "extensions": {
      "description": "A free map for adopters; never read by the core.",
      "type": "object"
    },
    "field_name": {
      "description": "An engine column name or one segment of a nested path.",
      "type": "string",
      "pattern": "^[^\\s.]+$"
    },
    "field_ref": {
      "description": "<entity-id>.<field name or path>",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(\\.[^\\s.]+)+$"
    },
    "hazard_id": {
      "type": "string",
      "pattern": "^H-[0-9]{4}$"
    },
    "hazard_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hazard_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "meaning",
        "expression",
        "aggregation",
        "grain"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "meaning": {
          "$ref": "#/$defs/text"
        },
        "expression": {
          "description": "An expression over <entity>.<field> columns, parsed by sqlglot (neutral dialect).",
          "$ref": "#/$defs/text"
        },
        "aggregation": {
          "enum": [
            "sum",
            "count",
            "count_distinct",
            "avg",
            "min",
            "max",
            "none"
          ]
        },
        "grain": {
          "description": "The entity a result row is at, and its key fields.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entity",
            "fields"
          ],
          "properties": {
            "entity": {
              "$ref": "#/$defs/slug"
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/field_name"
              }
            }
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "granularity"
          ],
          "properties": {
            "field": {
              "$ref": "#/$defs/field_ref"
            },
            "granularity": {
              "enum": [
                "day",
                "month",
                "quarter",
                "year"
              ]
            }
          }
        },
        "formula_source": {
          "description": "The evidence id of the documented formula, where one exists.",
          "$ref": "#/$defs/slug"
        },
        "hazards": {
          "$ref": "#/$defs/hazard_refs"
        },
        "suppressed": {
          "enum": [
            "exclude",
            "include",
            "not_applicable"
          ]
        },
        "companion": {
          "description": "With suppressed exclude, the measure that counts the withheld cells.",
          "$ref": "#/$defs/slug"
        }
      }
    },
    "measurement": {
      "description": "Counts and rates only, never values or identifiers.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "pin": {
      "description": "The exact version read; the format depends on the source kind.",
      "type": "string",
      "pattern": "^\\S.*@\\S+$"
    },
    "quote": {
      "description": "A verbatim quote, at most 40 words.",
      "type": "string",
      "pattern": "^\\s*\\S+(\\s+\\S+){0,39}\\s*$"
    },
    "relationship_ref": {
      "description": "<entity-id>.<relationship-key> (D-002)",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}\\.[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
