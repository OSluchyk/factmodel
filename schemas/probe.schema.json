{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factmodel:schema:probe:0.1.0",
  "title": "Probe",
  "description": "One generated data check. Returns counts and rates only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "probe_kind",
    "fact",
    "expected",
    "dialect",
    "sql"
  ],
  "properties": {
    "kind": {
      "const": "probe"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "probe_kind": {
      "enum": [
        "key_duplicates",
        "join_match",
        "fan_out",
        "null_rate",
        "row_count",
        "current_row_ties",
        "value_set"
      ]
    },
    "fact": {
      "description": "The fact the probe tests, as an entity, relationship or field reference.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(\\.[^\\s]+)?$"
    },
    "expected": {
      "description": "Expected range per metric.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        }
      }
    },
    "dialect": {
      "$ref": "#/$defs/slug"
    },
    "sql": {
      "$ref": "#/$defs/text"
    },
    "volatile": {
      "type": "boolean"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "extensions": {
      "description": "A free map for adopters; never read by the core.",
      "type": "object"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
