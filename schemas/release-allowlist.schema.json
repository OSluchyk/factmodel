{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factmodel:schema:release-allowlist:2.2.0",
  "title": "Release allowlist",
  "description": "File dispositions and per-kind key allowlists for a release. Fail-closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "files"
  ],
  "properties": {
    "kind": {
      "const": "release-allowlist"
    },
    "files": {
      "description": "Glob patterns, first match wins; every file must match exactly one disposition.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern",
          "disposition"
        ],
        "properties": {
          "pattern": {
            "$ref": "#/$defs/text"
          },
          "disposition": {
            "enum": [
              "export",
              "project",
              "refuse"
            ]
          },
          "reason": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "keys": {
      "description": "For projected files, the top-level keys each file kind keeps and drops. A key in neither list fails the release (fail-closed).",
      "type": "object",
      "propertyNames": {
        "enum": [
          "model-config",
          "source",
          "entity",
          "service",
          "tenants",
          "evidence",
          "finding",
          "escalation",
          "hazard",
          "decision",
          "profile",
          "layer",
          "consumer",
          "release-allowlist",
          "probe",
          "probe-result",
          "trigger"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keep"
        ],
        "properties": {
          "keep": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "drop": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "extensions": {
      "description": "A free map for adopters; never read by the core.",
      "type": "object"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
