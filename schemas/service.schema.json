{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factmodel:schema:service:1.0.0",
  "title": "Service",
  "description": "One process that reads or writes entities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "service_kind",
    "meaning",
    "evidence"
  ],
  "properties": {
    "kind": {
      "const": "service"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "service_kind": {
      "enum": [
        "pipeline",
        "scheduled_job",
        "application",
        "manual"
      ]
    },
    "meaning": {
      "$ref": "#/$defs/text"
    },
    "reads": {
      "$ref": "#/$defs/slugs"
    },
    "writes": {
      "$ref": "#/$defs/slugs"
    },
    "schedule": {
      "description": "When it runs, in plain words.",
      "$ref": "#/$defs/text"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "deprecated"
      ]
    },
    "hazards": {
      "$ref": "#/$defs/hazard_refs"
    },
    "evidence": {
      "$ref": "#/$defs/evidence_refs"
    },
    "records": {
      "$ref": "#/$defs/evidence_records"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "pin",
        "status",
        "read_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "source": {
          "$ref": "#/$defs/slug"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "measurement": {
          "$ref": "#/$defs/measurement"
        },
        "status": {
          "enum": [
            "confirmed",
            "inferred",
            "unresolved",
            "retracted"
          ]
        },
        "read_on": {
          "$ref": "#/$defs/date"
        },
        "probe": {
          "$ref": "#/$defs/slug"
        },
        "environment": {
          "$ref": "#/$defs/slug"
        },
        "data_quality": {
          "enum": [
            "representative",
            "synthetic",
            "unknown"
          ]
        },
        "named_error": {
          "$ref": "#/$defs/text"
        },
        "superseded_by": {
          "$ref": "#/$defs/slug"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "oneOf": [
        {
          "required": [
            "quote"
          ]
        },
        {
          "required": [
            "measurement"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "retracted"
              }
            }
          },
          "then": {
            "required": [
              "named_error",
              "superseded_by"
            ]
          }
        },
        {
          "if": {
            "required": [
              "probe"
            ]
          },
          "then": {
            "required": [
              "environment",
              "data_quality"
            ]
          }
        }
      ]
    },
    "evidence_records": {
      "description": "Inline evidence records.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_record"
      },
      "minItems": 1
    },
    "evidence_refs": {
      "description": "Evidence IDs; at least one.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "extensions": {
      "description": "A free map for adopters; never read by the core.",
      "type": "object"
    },
    "hazard_id": {
      "type": "string",
      "pattern": "^H-[0-9]{4}$"
    },
    "hazard_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hazard_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "measurement": {
      "description": "Counts and rates only, never values or identifiers.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "pin": {
      "description": "The exact version read; the format depends on the source kind.",
      "type": "string",
      "pattern": "^\\S.*@\\S+$"
    },
    "quote": {
      "description": "A verbatim quote, at most 40 words.",
      "type": "string",
      "pattern": "^\\s*\\S+(\\s+\\S+){0,39}\\s*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "slugs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
