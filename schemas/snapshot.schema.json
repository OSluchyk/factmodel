{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factmodel:schema:snapshot:1.0.0",
  "title": "Metadata snapshot",
  "description": "An engine-neutral export of a source's metadata. Not a model file kind; adapters read it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "engine",
    "target",
    "taken_on",
    "objects"
  ],
  "properties": {
    "kind": {
      "const": "snapshot"
    },
    "source": {
      "$ref": "#/$defs/slug"
    },
    "engine": {
      "$ref": "#/$defs/slug"
    },
    "target": {
      "description": "What was read, for example a project and dataset.",
      "$ref": "#/$defs/text"
    },
    "taken_on": {
      "$ref": "#/$defs/date"
    },
    "pin": {
      "description": "The version read; drafts cite it unless an object has its own pin.",
      "$ref": "#/$defs/pin"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_type",
        "fields",
        "enforced"
      ],
      "properties": {
        "constraint_type": {
          "enum": [
            "primary_key",
            "unique",
            "foreign_key"
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_name"
          },
          "minItems": 1
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object",
            "fields"
          ],
          "properties": {
            "object": {
              "$ref": "#/$defs/text"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field_name"
              },
              "minItems": 1
            }
          }
        },
        "enforced": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "constraint_type"
            ],
            "properties": {
              "constraint_type": {
                "const": "foreign_key"
              }
            }
          },
          "then": {
            "required": [
              "references"
            ]
          }
        }
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "extensions": {
      "description": "A free map for adopters; never read by the core.",
      "type": "object"
    },
    "field_name": {
      "description": "An engine column name or one segment of a nested path.",
      "type": "string",
      "pattern": "^[^\\s.]+$"
    },
    "field_path": {
      "description": "Dotted path of a nested field, at least two segments.",
      "type": "string",
      "pattern": "^[^\\s.]+(\\.[^\\s.]+)+$"
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "object_type",
        "fields"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "object_type": {
          "enum": [
            "table",
            "view",
            "materialized_view",
            "external"
          ]
        },
        "pin": {
          "description": "Where this object was read, when it differs per object (a DDL file at a commit).",
          "$ref": "#/$defs/pin"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snapshot_field"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "partitioning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "$ref": "#/$defs/field_name"
            },
            "granularity": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "clustering": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_name"
          },
          "uniqueItems": true
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "pin": {
      "description": "The exact version read; the format depends on the source kind.",
      "type": "string",
      "pattern": "^\\S.*@\\S+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "snapshot_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "nullable"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/field_name"
        },
        "path": {
          "$ref": "#/$defs/field_path"
        },
        "type": {
          "$ref": "#/$defs/text"
        },
        "type_class": {
          "enum": [
            "integer",
            "decimal",
            "float",
            "boolean",
            "text",
            "date",
            "time",
            "timestamp",
            "interval",
            "binary",
            "json",
            "array",
            "struct",
            "geography",
            "other"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "repeated": {
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
