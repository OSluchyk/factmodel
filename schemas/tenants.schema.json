{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factmodel:schema:tenants:2.0.0",
  "title": "Tenants",
  "description": "Tenants and environments. Ingest and presence are separate facts and never merged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "environments",
    "tenants"
  ],
  "properties": {
    "kind": {
      "const": "tenants"
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tenants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tenant"
      }
    },
    "records": {
      "$ref": "#/$defs/evidence_records"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "pin",
        "status",
        "read_on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "source": {
          "$ref": "#/$defs/slug"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "quote": {
          "$ref": "#/$defs/quote"
        },
        "measurement": {
          "$ref": "#/$defs/measurement"
        },
        "status": {
          "enum": [
            "confirmed",
            "inferred",
            "unresolved",
            "retracted"
          ]
        },
        "read_on": {
          "$ref": "#/$defs/date"
        },
        "probe": {
          "$ref": "#/$defs/slug"
        },
        "environment": {
          "$ref": "#/$defs/slug"
        },
        "data_quality": {
          "enum": [
            "representative",
            "synthetic",
            "unknown"
          ]
        },
        "named_error": {
          "$ref": "#/$defs/text"
        },
        "superseded_by": {
          "$ref": "#/$defs/slug"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "oneOf": [
        {
          "required": [
            "quote"
          ]
        },
        {
          "required": [
            "measurement"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "retracted"
              }
            }
          },
          "then": {
            "required": [
              "named_error",
              "superseded_by"
            ]
          }
        },
        {
          "if": {
            "required": [
              "probe"
            ]
          },
          "then": {
            "required": [
              "environment",
              "data_quality"
            ]
          }
        }
      ]
    },
    "evidence_records": {
      "description": "Inline evidence records.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_record"
      },
      "minItems": 1
    },
    "evidence_refs": {
      "description": "Evidence IDs; at least one.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "extensions": {
      "description": "A free map for adopters; never read by the core.",
      "type": "object"
    },
    "measurement": {
      "description": "Counts and rates only, never values or identifiers.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "per_environment": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entities",
          "evidence"
        ],
        "properties": {
          "entities": {
            "$ref": "#/$defs/slugs"
          },
          "evidence": {
            "$ref": "#/$defs/evidence_refs"
          }
        }
      }
    },
    "pin": {
      "description": "The exact version read; the format depends on the source kind.",
      "type": "string",
      "pattern": "^\\S.*@\\S+$"
    },
    "quote": {
      "description": "A verbatim quote, at most 40 words.",
      "type": "string",
      "pattern": "^\\s*\\S+(\\s+\\S+){0,39}\\s*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "slugs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "meaning": {
          "$ref": "#/$defs/text"
        },
        "ingest": {
          "description": "Per environment, what the configuration accepts.",
          "$ref": "#/$defs/per_environment"
        },
        "presence": {
          "description": "Per environment, what the data shows.",
          "$ref": "#/$defs/per_environment"
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
